		// Bots Server title
		itemDef 
		{
			name				bots
			group				none
			style				WINDOW_STYLE_SHADER
			background			"gfx/menus/menu_blendbox"
			text				bots
      			rect				155 5 330 16			font				3
			textscale			0.7
			textalign			ITEM_ALIGN_CENTER		
			textalignx			165
			textaligny			-1
			forecolor			.549 .854 1 1
      			visible			1 
      			decoration 
		}

