//
// DONE BUTTON
//
//---------------------------------

		itemDef 
		{
			name					doneButton
			group					none
			style					WINDOW_STYLE_SHADER
			rect				240 405 160 30			background				"gfx/menus/menu_buttonback"			// Frame around button
			forecolor				1 1 1 1
			decoration
			visible				0
		}

		itemDef 
		{
			name					done
			text					@MENUS_DONE
			descText				@MENUS_GO_BACK_TO_STANDARD_SETTINGS
			type					ITEM_TYPE_BUTTON
			font					3
			textscale				1
			style					WINDOW_STYLE_EMPTY
			rect				240 405 160 30			textalignx				80						// Center
			textaligny				0
			textalign				ITEM_ALIGN_CENTER
			forecolor			1 .682 0 1
			visible				1 
			action 
			{ 
				play				"sound/interface/button1.wav" ;
				close				botscreateserver ; 
				open				createserver ; 
			}
			mouseEnter 
			{ 
				show				doneButton
			}
			mouseExit 
			{ 
				hide				doneButton
			}	  	  
		}

	}
