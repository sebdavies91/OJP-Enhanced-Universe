//----------------------------------------------------------------------------------------------
//	MAIN MENU
//----------------------------------------------------------------------------------------------
//[OLDGAMETYPES]
//ui_netGameType
//0 = FFA
//1 = Holocron FFA
//2 = Jedi Master
//3 = Duel
//4 = Power Duel
//5 = Team FFA 
//6 = Siege
//7 = Capture the Flag
//8 = Capture the Ysalimari

/*
//ui_net_gametype
//	0 = FFA
//	1 = DUEL
//	2 = POWER DUEL
//	3 = TEAM FFA
//	4 = SIEGE
//	5 = CTF
*/

//[/OLDGAMETYPES]

{
	menuDef  
	{
		name					"botscreateserver"
		fullScreen				MENU_TRUE				
		rect					0 0 640 480						// Size and position of the menu
		visible					MENU_FALSE							// Visible on open
		focusColor				1 1 1 1							// Focus color for text and items
		descX					360
		descY					426
		descScale				1
		descColor				1 .682 0 .8
		descAlignment				ITEM_ALIGN_CENTER		
		popup
		outOfBoundsClick										// this closes the window if it gets a click out of the rectangle


		
		onESC 
		{ 
			play				"sound/interface/button1.wav" ; 
			close				botscreateserver ; 
			open				createserver ;
		}

		itemDef 
		{
			name				setup_background
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 0 640 480	
			backcolor			0 0 0 1
			forecolor			1 1 1 1
			border			0
			visible				1
			decoration
		}

		/*itemDef 
		{
			name					frame_pic
			group					none
			style					WINDOW_STYLE_SHADER
			rect				20 10 560 380
			background				"gfx/menus/menu_box_ingame"
			forecolor				1 1 1 1
			decoration
			visible			0 
			appearance_slot			1
		}*/


