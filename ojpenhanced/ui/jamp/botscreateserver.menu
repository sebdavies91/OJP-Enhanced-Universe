//	SKILL BUTTON
//---------------------------------------------



		itemDef 
		{
			name				difficultyfield
			group				grpsettings
			style				0	
			ownerdraw			UI_SKILL
			text				"Skill:"
			descText			@MENUS_ADJUSTS_THE_DIFFICULTY
			rect				440 365 175 24 			textalign			ITEM_ALIGN_RIGHT		
			textalignx			10     
			textaligny			2
			font				4
			textscale			1
			forecolor			0.7 0.7 0.7 1
			visible				1
			cvarTest			"ui_netGameType"
			action 
			{ 
				play			"sound/interface/button1.wav" 
			}  	  
		}

		itemDef 
		{
			name				bottype
			group				grpsettings
			style				0	
			type				ITEM_TYPE_MULTI
			text				"Bot Type:"
			descText			@MENUS_ADJUSTS_THE_DIFFICULTY
			cvar				"ui_bottype"
			cvarFloatList		
			{ 
				"Jedi Academy"	 		0
				"Force Unleashed"			1
//[AotCAI]
				"Battlefront"			2
//[/AotCAI]
				"Hybrid"			3
			}
			rect				420 385 175 24 
			textalign			ITEM_ALIGN_RIGHT		
			textalignx			10     
			textaligny			2
			font				4
			textscale			1
			forecolor			0.7 0.7 0.7 1
			visible				1
			action 
			{ 
				play			"sound/interface/button1.wav" 
			}  	  
		}
		
itemDef 
{
	name				defaultbots
	group				grpsettings
	style				0	
	type				ITEM_TYPE_BUTTON
	text				"Default"
	descText			"Reset all 32 bot slots to HUMAN"
	rect				440 405 175 24 	textalign			ITEM_ALIGN_RIGHT		
	textalignx			10     
	textaligny			2
	font				4
	textscale			1
	forecolor			0.7 0.7 0.7 1
	visible				1
	action 
	{ 
