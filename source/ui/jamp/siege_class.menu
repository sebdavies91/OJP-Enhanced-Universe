				setitemcolor		team2obj_buttons	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		team2obj_buttons backcolor 0 0 0 0 ;
				setitemcolor		team1obj_buttons 	bordercolor 0 0 0 0 ;
				setitemcolor		team2obj_buttons 	bordercolor 0 0 0 0 ;

				// Disable current button
				setcvar			currentObjButton	"team1obj3_button"			
				setitemcolor		team1obj3_button	bordercolor			.33 .33 .33 1 ;
				setitemcolor		team1obj3_button 	backcolor 0.82 0.84 0.88 1 ;
	
				// Completed text				
