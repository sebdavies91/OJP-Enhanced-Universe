//--------------------------------------------------------------------------------------------
// uberScreen
//
// cvars used (at least some of them
//	siege_mapgraphic - the name of the graphic of the map of the level.
//	currentObjButton - the menu item name of currently active objective button
//
//	team1_icon	- read in from siege file, the graphic of team1
//	team2_icon	- read in from siege file, the graphic of team2
//
//--------------------------------------------------------------------------------------------
{
	menuDef 
	{	
		name 					"ingame_siegeclass"
  		fullScreen					0				
 		visible 				0
		outOfBoundsClick	
		rect					0 45 640 480
		focusColor			0.82 0.84 0.88 1
		style					1
		descX					480
		descY					421
		descScale				1
		descColor				0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER
		backColor				0 0 0 0
		disablecolor				0.82 0.84 0.88 1
		onClose 
		{ 
			hide				minidesc
			hide				obj_longdesc
			hide				objective_pic
			hide				objectivetitle
			hide				siegeclassconfigtitle
		}
		
		onOpen 
		{ 
			setcvar				currentObjButton "null"

			exec				"siegeCompleteCvarUpdate"
			
			setitembackground		mappic 		"*siege_mapgraphic"

			// set tm_icon fields to the proper mapicon graphic 
			uiscript			updatesiegeobjgraphics
			
			setitembackground		team1_symbol	"*team1_icon"
			setitembackground		team2_symbol	"*team2_icon"
			setitembackground		team1_button	"*team1_icon"
			setitembackground		team2_button	"*team2_icon"
						
			// Enable team buttons, in case they'd been shut off
			disable				team_button	0
			disable				autoteam	0
			disable				team1_button	0
			disable				team2_button	0

			// and reset colors
			setitemcolor			team1_button backcolor   0.1 0.1 0.1 0.45 ;
			setitemcolor			team2_button backcolor   0.1 0.1 0.1 0.45 ;
			setitemcolor		team1name	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		team2name	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		team1_count	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		team2_count	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		siegeclassconfigtitle	forecolor 0.82 0.84 0.88 1 ;
			
			// 
			setitemcolor			team1obj_buttons bordercolor	0 0 0 0 ;
			setitemcolor			team2obj_buttons bordercolor	0 0 0 0 ;
			setitemcolor		team1obj_buttons	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		team2obj_buttons	forecolor 0.82 0.84 0.88 1 ;

			disable				team1obj_buttons	0
			disable				team2obj_buttons	0
			
			hide				grey_button
			hide				class_portrait
			hide				itemdescription

			// Show first objective			
			show			obj_minidesc
			show			obj_longdesc
			show			objective_pic
			
			// change color and stext of mini desc
			setitemtext		obj_minidesc @MENUS_OBJECTIVE_1

			//change text of long desc
			setitemtext		obj_longdesc "*team1_objective1_longdesc"
			
			// change objective pic
			setitembackground	objective_pic	"*team1_objective1_gfx"

			// Show new map icon
			setitembackground	tm1_icon1	"*team1_objective1_mapicon"
			
			// Reset all buttons to their normal colors
			setitemcolor		team1obj_buttons	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		team1obj_buttons backcolor 0 0 0 0 ;
			setitemcolor		team2obj_buttons	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		team2obj_buttons backcolor 0 0 0 0 ;

			setitemcolor		mapicons	bordercolor	0 0 0 0 ;
			
			// Disable current button and give it a border
			setitemcolor		team1obj1_button 	bordercolor 0.33 0.33 0.33 1 ;
			setitemcolor		team1obj1_button 	backcolor 0 0 0 0 ;

			// Set the map icon picture to the updated graphic
			uiscript		setsiegeobjbuttons tm1_icon1   team1_objective1_mapicon   team1_objective1_litmapicon
			uiscript		setteamclassicons

			// OBP refined compact join screen cleanup.
			// OBP: this is now a compact profile-style class menu; keep objectives hidden.
			hide				team1obj_buttons
			hide				team2obj_buttons
			hide				mapicons
			hide				completed_text
			hide				obj_minidesc
			hide				obj_longdesc
			hide				objective_pic

			// OBP: Siege class menu is now profile-style. Keep objective/map widgets hidden here.
			hide				team1obj_buttons
			hide				team2obj_buttons
			hide				mapicons
			hide				completed_text
			hide				obj_minidesc
			hide				obj_longdesc
			hide				objective_pic
			hide				objectivetitle
			hide				feeders
			hide				stats
			hide				forcepowerlevel
			hide				classdescription
			hide				itemdescription

		}
		
		onESC 
		{ 
			hide				stats
			hide				forcepowerlevel
			hide				minidesc
			hide				fulldesc	
			hide				objective_pic			
			disable				team_button	0
			close 				all;
		}

	//------------------------------------------------------------		
	// Window backdrop
	//------------------------------------------------------------		
		itemDef 
		{
			name				background_pic
			backcolor				0.08 0.08 0.08 0.72
			bordercolor				.33 .33 .33 1
			border				1
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 3 120 399
			background				""
			forecolor				0.82 0.84 0.88 1
			visible				1
			decoration
		}

		// OBP profile-style right panel
		itemDef
		{
			name				obp_profile_right_panel
			group				none
			style				WINDOW_STYLE_FILLED
			rect				125 3 514 399
			border				1
			bordercolor				.33 .33 .33 1
			backcolor				0.08 0.08 0.08 0.68
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

		// OBP profile-style bottom button panel
		itemDef
		{
			name				obp_profile_bottom_panel
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 405 639 30
			border				1
			bordercolor				.33 .33 .33 1
			backcolor				0.08 0.08 0.08 0.75
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

		
		// Title of objective section
		itemDef 
		{
			name 				objectivetitle
			style				WINDOW_STYLE_FILLED
			backcolor			0.1 0.1 0.1 0.7
			text 				@MENUS_MISSION_OBJECTIVES
			rect				-1000 -1000 1 1
			textalign			ITEM_ALIGN_CENTER		
			textalignx			450
			textaligny			-1
			font				3
			textscale			0.9
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}

		// Border around the objective half of the screen		
		itemDef 
		{
			name				border
			group				none
			type 				ITEM_TYPE_TEXT
			rect				0 0 0 0
//			forecolor			0.82 0.84 0.88 .6
			visible				0
			border				1
			bordercolor			.33 .33 .33 1
			decoration
		}


		itemDef 
		{
			name				mapname
			group				time
			style				WINDOW_STYLE_EMPTY
//			text				@MENUS_MISSION
			cvar				siege_missionname
			maxChars			0
			rect				-1000 -1000 1 1
			textalign			ITEM_ALIGN_CENTER	
			textalignx			90
			font				3
			textscale			.7
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}
		
		//------------------------------------------------------------		
		// Map picture
		//------------------------------------------------------------		
		itemDef 
		{
			name				mappic
			group				none
			style				WINDOW_STYLE_SHADER
			rect				-1000 -1000 1 1
			forecolor			0.82 0.84 0.88 1
			visible				0
			border				1
			bordercolor 0.38 0.41 0.46 1
			decoration
			background			"*siege_mapgraphic"
		}

	
//----------------------------------------------------------------------------------------------
// TEAM SYMBOLS
//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name				team1_symbol
			style				WINDOW_STYLE_SHADER
			rect				-1000 -1000 1 1
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}
		
		itemDef 
		{
			name				team2_symbol
			style				WINDOW_STYLE_SHADER
			rect				-1000 -1000 1 1
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}
		
//-------------------------------------------
// TEAM1 - OBJECTIVE BUTTON 1
//-------------------------------------------
		itemDef 
		{
			name 				team1obj1_button
			group				team1obj_buttons
			rect				-1000 -1000 1 1
			type 				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_FILLED
			text 				@MENUS_1
			descText			"View objective details"
			font				2
			textscale 			.8
			textstyle 			0
			textalign 			ITEM_ALIGN_CENTER
			textalignx 			12
			textaligny 			-1
			backcolor			0.82 0.84 0.88 1
			forecolor			0.82 0.84 0.88 1
			visible				0
			border				1
			bordercolor			0 0 0 0
			mouseEnter 
			{ play "sound/interface/button2.wav" ; 
				setitemcolor		team1obj1_button	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		team1obj1_button 	backcolor 0 0 0 0 ;
			} 
			mouseExit 
			{ 
				setitemcolor		team1obj1_button	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		team1obj1_button 	backcolor 0 0 0 0 ;
			} 
			action
			{ play "sound/interface/button1.wav" ;					
				// Because open and close menu hide these
				show			obj_minidesc
				show			obj_longdesc
				show			objective_pic
				
				// change text of mini desc
				setitemtext		obj_minidesc @MENUS_OBJECTIVE_1

				//change text of long desc
				setitemtext		obj_longdesc "*team1_objective1_longdesc"
				
				// change pic to match objective
				setitembackground	objective_pic	"*team1_objective1_gfx"
				
				// Reset all buttons to their normal colors
				setitemcolor		team1obj_buttons	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		team1obj_buttons 	backcolor .7 0 0 1 ;
				setitemcolor		team2obj_buttons	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		team2obj_buttons 	backcolor 0 0 .7 1 ;
				setitemcolor		team1obj_buttons 	bordercolor 0 0 0 0 ;
				setitemcolor		team2obj_buttons 	bordercolor 0 0 0 0 ;

				// Disable current button and give it a border
				setcvar			currentObjButton	"team1obj1_button"
				setitemcolor		team1obj1_button 	bordercolor			.33 .33 .33 1 ;
				setitemcolor		team1obj1_button 	backcolor 0 0 0 0 ;

				// Completed text				
				hide				completed_text
				show				text_tm1_obj1
				
				// Reset old map icon to old background and enable old obj button
				// Set new map icon to hilite background and disable new obj button
				uiscript			setsiegeobjbuttons tm1_icon1   team1_objective1_mapicon   team1_objective1_litmapicon
			}
		}

//----------------------------------------------------------------------------------------------
// TEAM1 - OBJECTIVE BUTTON 2
//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name 				team1obj2_button			
			group				team1obj_buttons
			rect				-1000 -1000 1 1
			type 				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_FILLED
			text 				@MENUS_2
			descText			"View objective details"
			font				2
			textscale 			.8
			textstyle 			0
			textalign 			ITEM_ALIGN_CENTER
			textalignx 			12
			textaligny 			-1
			backcolor			.7 0 0 1
			forecolor			0.82 0.84 0.88 1
			visible				0
			border				1
			bordercolor			0 0 0 1
			cvartest			"team1_objective2_inuse"
			showcvar
			{
				"1"; "2"
			}
			mouseEnter 
			{ play "sound/interface/button2.wav" ; 
				setitemcolor		team1obj2_button	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		team1obj2_button backcolor 0.82 0.84 0.88 1 ;
			} 
			mouseExit 
			{ 
				setitemcolor		team1obj2_button	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		team1obj2_button backcolor .7 0 0 1 ;
			} 

			action
			{ play "sound/interface/button1.wav" ;						
				// Because open and close menu hide these
				show			obj_minidesc
				show			obj_longdesc
				show			objective_pic
				
				// change color and text of mini desc
				setitemtext		obj_minidesc @MENUS_OBJECTIVE_2

				//change text of long desc
				setitemtext		obj_longdesc "*team1_objective2_longdesc"
				
				// change pic to match objective
				setitembackground	objective_pic	"*team1_objective2_gfx"
							
				// Reset all buttons to their normal colors
				setitemcolor		team1obj_buttons	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		team1obj_buttons backcolor 0 0 0 0 ;
				setitemcolor		team2obj_buttons	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		team2obj_buttons backcolor 0 0 0 0 ;
				setitemcolor		team1obj_buttons 	bordercolor 0 0 0 0 ;
				setitemcolor		team2obj_buttons 	bordercolor 0 0 0 0 ;

				// Disable current button
				setcvar			currentObjButton	"team1obj2_button"			
				setitemcolor		team1obj2_button	bordercolor			.33 .33 .33 1 ;
				setitemcolor		team1obj2_button 	backcolor	 0.82 0.84 0.88 1 ;
				
				// Completed text				
				hide				completed_text
				show				text_tm1_obj2
				
				// Reset old map icon to old background and enable old obj button
				// Set new map icon to hilite background and disable new obj button
				uiscript			setsiegeobjbuttons tm1_icon2   team1_objective2_mapicon   team1_objective2_litmapicon
								
			}
		}
		
