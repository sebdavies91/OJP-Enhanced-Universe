//----------------------------------------------------------------------------------------------
//	BOTTOM MENU BUTTONS
//----------------------------------------------------------------------------------------------



		
		itemDef 
		{
			name				playbutton
			group				main_button
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect				-10 410 130 24
			text				@MENUS_PLAY					
			font				3
			textscale			1.1
			textaligny			0
			textalign			ITEM_ALIGN_CENTER
			textstyle			0
			textalignx			65
			forecolor 0.82 0.84 0.88 1
			visible				1


			
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	-10 410 130 24 ;
			}

			mouseExit
			{
				hide			button_glow ;
			}
action 
			{
				play				"sound/interface/button1.mp3" ; 			
			 
			close			all;
			open			multiplayermenu;
			}
		}

