// VIDEODRIVER MENU
{
	menuDef 
	{
		name					"videodriverMenu"
		visible					0
		fullScreen				0								// MENU_TRUE			
		rect					100 120 440 320
		focusColor			0.82 0.84 0.88 1
		outOfBoundsClick							// this closes the window if it gets a click out of the rectangle
		descX					320
		descY					421
		descScale				1
		descColor				0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER		
		popup
										
		onESC 
		{ 
			
			close				all
			open				setupMenu
		}

		onClose
		{
			
		}


		//----------------------------------------------------------------------------------------------
		//
		//	MENU BACKGROUND
		//
		//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name				driver_background
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 440 320
			background			"gfx/menus/menu_boxred"					// Frame
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

		itemDef 
		{
			name				driver_done_button
			group				none
			style				WINDOW_STYLE_SHADER
			rect				150 293 140 24
			background			"gfx/menus/menu_buttonback"			// Frame around button
			forecolor			0.82 0.84 0.88 1
			decoration
			visible				0
		}

		itemDef 
		{
			name				driver_done
			group				none
			text				@MENUS_DONE_CAPS
			descText			@MENUS_DONE_DESC
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				150 293 140 24
			forecolor			0.82 0.84 0.88 1
			textalign			ITEM_ALIGN_CENTER
			textstyle			0
			textalignx			70
			textaligny			0
			font				3
			textscale			1
			forecolor			0.82 0.84 0.88 1
			visible				1

			mouseEnter 
			{
				show			button_glow ;
				setitemrect		button_glow	150 293 140 24 ;
			}
			mouseExit 
			{
				hide			button_glow ;
			}	  	  
			action
			{
				play				"sound/interface/button1.mp3" ; 
				close videodriverMenu
			}
		}


		//----------------------------------------------------------------------------------------------
		//
		//	VIDEO DRIVER INFO
		//
		//----------------------------------------------------------------------------------------------
		itemDef													// Drivers
		{
			name				game_version
			group				none
			ownerdraw			UI_GLINFO								// UI_GLINFO
			font				4
			textscale			1
			rect				10 3 430 280
			forecolor			0.82 0.84 0.88 1
			style				WINDOW_STYLE_EMPTY
			textalign			ITEM_ALIGN_LEFT
			textaligny			14
			visible				1
			decoration 
		}
	

		// Shared hover glow for text buttons that use dynamic setitemrect.
		itemDef
		{
			name				button_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"gfx/menus/menu_buttonback"
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}
}
}