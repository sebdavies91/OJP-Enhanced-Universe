	   		visible 		0
			cvar 			"ui_r_glCustom"
			cvarFloatList 
			{ 
				@MENUS_HIGH_QUALITY	0 
				@MENUS_NORMAL		1 
				@MENUS_FAST			2 
				@MENUS_FASTEST		3 
				@MENUS_CUSTOM		4 
			}

			mouseexit 
			{ 
			} 
			mouseEnter
			{
				
			}

			action 
			{ 
				
				uiScript 		update "ui_r_glCustom"
				setcvar			ui_r_modified	1
				show			applyChanges
			}
		}

