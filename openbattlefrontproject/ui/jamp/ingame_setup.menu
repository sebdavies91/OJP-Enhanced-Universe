//[NewMenus]
//--------------------------------------------------------------
//
// SETUP MENU
//
//--------------------------------------------------------------
{
	menuDef 
	{
		name					"ingame_setup"
		visible					0
		fullscreen				0
		outOfBoundsClick									// this closes the window if it gets a click out of the rectangle
		rect					0 45 640 440
		focusColor			0.82 0.84 0.88 1
		style					1
		border					1
		descX					320
		descY					421
		descScale				1
		descColor			0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER		

		onOpen 
		{
			uiScript		getvideosetup				// Get video settings

			show			setup_background
			show			video
			hide			applyChanges
			hide			video2
			hide			vidrestart
			hide			sound
			hide			options
			hide			mods
			hide			defaults
			hide			default_glow
			hide			highlight12
			//[UITweaks]
			hide			advanced
			//[/UITweaks]
			setitemcolor		setup_submenu	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		videomenubutton	forecolor 0.82 0.84 0.88 1 ;
		}
			
		onESC 
		{ 
			

			defer				VideoSetup	videowarningMenu
			hide				highlights
			close				ingame_setup
		}


		// Overall window backdrop
		itemDef 
		{
			name				background_pic
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 3 639 437
			border				1
			bordercolor			.33 .33 .33 1
			backcolor			0.1 0.1 0.1 0.5
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}
		itemDef 
		{
			name				playerconfigtitle
			style				WINDOW_STYLE_FILLED
			text				@MENUS_SETUP
			rect				3 6 633 21
			textalign			ITEM_ALIGN_CENTER		
			textalignx			316
			textaligny			-2
			outlinecolor		.5 .5 .5 .5
			backcolor			0.1 0.1 0.1 0.5
			font				3
			textscale			1
			forecolor			0.82 0.84 0.88 1
			border				0
			bordercolor			.33 .33 .33 1
			visible				1 
		} 

		// video1 button
		itemDef 
		{
			name				video1menubutton
			group				setup_submenu
			text				@MENUS_VIDEO
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				5 75 170 30
			font				3
			textscale			0.8
			textalignx			170
			textaligny			5
			textstyle			0
			textalign			ITEM_ALIGN_RIGHT
			forecolor			0.82 0.84 0.88 1
			visible				1
			descText			@MENUS_CONFIGURE_VIDEO_SETTINGS

			mouseEnter 
			{
				show			button_glow ;
				setitemrect		button_glow	5 75 170 30 ;
			}
			mouseExit 
			{
				hide			button_glow ;
			}	  	  
			action 
			{
				play				"sound/interface/button1.mp3" ; 
				

				defer			VideoSetup	videowarningMenu

				uiScript		getvideosetup		// Get video settings

				show			setup_background
				show 			video
				hide			applyChanges
				hide			video2
				hide			vidrestart
				hide			sound
				hide			options
				hide			mods
				hide			defaults
				//[UITweaks]
				hide			advanced
				//[/UITweaks]
				setitemcolor		setup_submenu	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		video1menubutton	forecolor 0.82 0.84 0.88 1 ;
			}
		}

