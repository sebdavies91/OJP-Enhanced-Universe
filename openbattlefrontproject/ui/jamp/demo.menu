			text				@MENUS_SOLO_GAME
			descText			@MENUS_QUICKSTART_DESC
			font				3
			textscale			0.85
			textaligny			0
			textalign			ITEM_ALIGN_CENTER
			textstyle			0
			textalignx			62
			forecolor			0.82 0.84 0.88 1
			visible				1
			mouseEnter 
			{  
				show			quickserver_button_glow 
			}
			mouseExit 
			{ 
				hide			quickserver_button_glow 
			}	  	  
			action 
			{
				play				"sound/interface/button1.mp3" ; 
				
				close			All ; 
				open quickgame
			}
		}

