///////////////////////////////////
// TITLE BAR
///////////////////////////////////


		itemDef 
		{
			name				demolist
			rect				55 150 530 260 
			type				ITEM_TYPE_LISTBOX
			style				WINDOW_STYLE_FILLED
			elementwidth			120
			elementheight			20
			//background			"gfx/menus/menu_box1"
			font				3
			textscale			.8
			elementtype			LISTBOX_TEXT
			feeder				FEEDER_DEMOS
			textalign			3
			textaligny			22
			border				1
			bordercolor			.8 .8 .8 1
			outlinecolor			.5 .5 .5 .5
			forecolor			0.82 0.84 0.88 1
			backcolor			0 0 0 .6
			visible				1
			doubleclick
			{
				
				close demo ; 
				uiScript RunDemo 
			}
		}


		
itemDef 
{
	name				begin_glow
