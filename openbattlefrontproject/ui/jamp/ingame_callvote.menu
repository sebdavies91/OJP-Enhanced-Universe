//[NewMenus]
\\ CALL VOTE MENU \\
{
	menuDef  
	{
		name					"ingame_callvote"
		visible					0
		fullscreen				0
		outOfBoundsClick									// this closes the window if it gets a click out of the rectangle
		rect					0 45 640 440
		focusColor			0.82 0.84 0.88 1
		style					1
		border					1
		descX					320
		//[AdminSys]
		descY					421
		//descY					210
		//[/AdminSys]
		descScale				1
		descColor			0.82 0.84 0.88 1
		descAlignment			ITEM_ALIGN_CENTER		
		onopen 
		{ 
			uiscript 			clearmouseover	map ;
			uiscript 			clearmouseover	type ;
			uiscript 			clearmouseover	kick ;
			//[AdminSys]
			uiscript 			clearmouseover	kickally ;
			//[/AdminSys]
			hide				doneButton ;
			hide				grpcallVote ; 
			show				misc ; 
			uiScript			loadArenas ;
			setitemcolor		grpbutton	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		miscbutton	forecolor 0.82 0.84 0.88 1 ;
			uiscript			resetmaplist ;
		}

		
	// Overall window backdrop
		itemDef 
		{
			name				background_pic
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 3 639 437
			border				1
			bordercolor			.33 .33 .33 1
			backcolor			0.1 0.1 0.1 0.5
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

		itemDef 
		{
			name				playerconfigtitle
			style				WINDOW_STYLE_FILLED
			text				"Call Vote"
			rect				3 6 633 21
			textalign			ITEM_ALIGN_CENTER		
			textalignx			316
			textaligny			-2
			outlinecolor		.5 .5 .5 .5
			backcolor			0.1 0.1 0.1 0.5
			font				3
			textscale			1
			forecolor			0.82 0.84 0.88 1
			border				0
			bordercolor			.33 .33 .33 1
			visible				1 
		}

		
