//--------------------------------------------------------------
//
// profile CONTROLS MENU
//
//--------------------------------------------------------------
{
	menuDef 
	{
		name				"controlsMenu"
		fullScreen			1					// MENU_TRUE				
		rect				0 0 640 480				// Size and position of the menu
		visible				0					// Visible on open
		focusColor			0.82 0.84 0.88 1
		descX				320
		descY					421
		descScale			1
		descColor				0.82 0.84 0.88 1
		descAlignment			ITEM_ALIGN_CENTER		

		onOpen 
		{
			uiScript 		loadControls;

			show			setup_background ;
			show 			movecontrols ;
			hide 			attackcontrols ;
			hide			weaponcontrols ;
			hide			forcecontrols ;
			hide			forcecontrols2 ;
			hide 			quickcontrols ;
			hide			joycontrols ;
			hide			othercontrols ;
			setitemcolor		movementcontrolbutton	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		attackcontrolbutton	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		weaponscontrolbutton	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		forcecontrolbutton	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		forcecontrolbutton2	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		quickcontrolbutton	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		mousejoystickcontrolbutton	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		othercontrolbutton	forecolor 0.82 0.84 0.88 1 ;
		}

		onClose 
		{
			uiScript 			saveControls
		}
									
		onESC 
		{ 
				
				close			all ; 
				open			mainMenu 
		}

