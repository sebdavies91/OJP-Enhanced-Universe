	//----------------------------------------------------------------------------------------------
	//
	//	QUIT MENU
	//
	//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"quitMenu"
		visible				0
		fullScreen				0								// MENU_TRUE				
		rect					0 0 320 240					// Size and position of the menu
		focusColor			0.82 0.84 0.88 1
		descX				320
		descY					421
		descScale			1
		descColor				0.82 0.84 0.88 1
		descAlignment			ITEM_ALIGN_CENTER

		appearanceIncrement		100								// In miliseconds

		appearanceIncrement		100								// In miliseconds
		style				1
		popup

		onESC 
		{ 
			close				quitMenu ;
		}

		onOpen 
		{
			setfocus			quitgame_cancel
		}

		
		//----------------------------------------------------------------------------------------------
		//
		//	MENU BACKGROUND
		//
		//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name				really_background
			group				none
			style				WINDOW_STYLE_FILLED
			rect				156 154 320 240
			backcolor			0 0 0 1
			visible				1
			decoration
		}

		itemDef 
		{
			name				background
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 0 640 480
			backcolor			0 0 0 1
			visible				1
			decoration
		}

		itemDef 
		{
			name				background_text
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 0 160 480
			backcolor			0 0 0 1
			visible				1
			decoration
		}

		itemDef 
		{
			name				background_text_b
			group				none
			style				WINDOW_STYLE_FILLED
			rect				480 0 160 480
			backcolor			0 0 0 1
			visible				1
			decoration
		}	

		itemDef
		{
			name				bgpic
			style				WINDOW_STYLE_SHADER
			rect				0 127 640 314
			background			"obp/menu/taris"
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

		itemDef
		{
			name				mainbackground
			style				WINDOW_STYLE_FILLED
			rect				0 127 640 314
			backcolor			0 0 0 0.8
			visible				1
			decoration
		}

	


		itemdef
		{
			name				lowbar
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 428 640 18
			background			"obp/menu/lowbar"
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

		itemdef
		{
			name				topbar
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 85 640 18
			background			"obp/menu/topbar"
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}




		itemDef 
		{
			name				obplogo
			group				none
			style				WINDOW_STYLE_SHADER
			rect				220 0 200 90
			background			"obp/menu/obplogo"
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}



		itemDef 
		{
			name			confirm
			group			none
			text 			"ARE YOU SURE YOU WANT TO QUIT?"
			font			3
			textscale 		0.7
			textstyle 		0
			rect 			88 168 450 20
			textalign 		ITEM_ALIGN_CENTER
			textalignx 		225
			textaligny	 	0
			decoration
			forecolor			0.82 0.84 0.88 1
			visible 		1
		}

	


		// CANCEL button
		itemDef 
		{
			name			quitgame_cancel
			group			none
			text			"No"

			type			ITEM_TYPE_BUTTON
			style			WINDOW_STYLE_EMPTY
			rect			238 310 320 24
			font			3
			textscale		0.7
			textalignx		160
			textaligny		7
			textalign		ITEM_ALIGN_CENTER
			textstyle		0
			descText		@MENUS_DO_NOT_LEAVE_JEDI_KNIGHT
			forecolor			0.82 0.84 0.88 1
			visible		1
			action 
			{
				play				"sound/interface/button1.mp3" ; 
				
				close		quitMenu ; 
			}
			mouseEnter 
			{
				show			button_glow ;
				setitemrect		button_glow	238 310 320 24 ;
			}
			mouseExit 
			{
				hide			button_glow ;
			}	  	  
		}


		// YES button
		itemDef 
		{
			name				quitgame_yes
			group				none
			text				"Yes"

			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				88 310 220 24
			font				3
			textscale			0.7
			textalignx			160
			textaligny			7
			textalign			ITEM_ALIGN_CENTER
			textstyle			0
			descText			@MENUS_JEDI_KNIGHT_II
			forecolor			0.82 0.84 0.88 1
			visible				1
		      	action 
			{
				play				"sound/interface/button1.mp3" ; 
				
				uiScript	Quit			// Quit the game
			}

			mouseEnter 
			{
				show			button_glow ;
				setitemrect		button_glow	88 310 220 24 ;
			}
			mouseExit 
			{
				hide			button_glow ;
			}	 
	  	  
		}

	

		// Shared hover glow for text buttons that use dynamic setitemrect.
		itemDef
		{
			name				button_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"gfx/menus/menu_buttonback"
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}
}
}














