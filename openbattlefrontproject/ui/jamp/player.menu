}
	
		
// Scroll box with portraits.
		itemDef 
		{
			name 				headlist
			rect 				55 150 531 260
//			rect 				156 215 80 200
			type 				ITEM_TYPE_LISTBOX
			style 				WINDOW_STYLE_FILLED
			elementwidth 			64
			elementheight 			64
			elementtype 			LISTBOX_IMAGE
			feeder 				FEEDER_Q3HEADS
//			horizontalscroll
			backcolor 			0 0 0 1
			border 				1
			bordercolor 			.5 .5 .5 1
			forecolor			0.82 0.84 0.88 1
			descText			@MENUS_CHOOSE_THE_MODEL_FOR
			visible 			1
			textscale 			0.7
			action 
			{ 
				
			}
			mouseenter 
			{ 
				setitemcolor headlist bordercolor 0.38 0.41 0.46 1 ;
			}
			mouseexit 
			{ 
				setitemcolor headlist bordercolor .5 .5 .5 1 ;
			}
		}

