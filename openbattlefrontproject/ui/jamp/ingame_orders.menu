{
\\ SETUP MENU \\
{
	menuDef 
	{
		name					"ingame_orders"
		visible					0
		fullscreen				0
		rect					45 45 200 240
		outOfBoundsClick							// this closes the window if it gets a click out of the rectangle
		focusColor			0.82 0.84 0.88 1
		style					1
		border					1
		disableColor			0.82 0.84 0.88 1

		descX					320
		descY					421
		descScale				1
		descColor			0.82 0.84 0.88 1
		descAlignment			ITEM_ALIGN_CENTER
		onopen 
		{ 
			hide				grpicon ; 
			show				attack 
		}

		itemDef 
		{
			name				window
			rect				10 15 180 225
			style				1
			backcolor			0.1 0.1 0.1 0.5
			visible				1
			decoration
		}

		itemDef 
		{
			name				orders
			group				grporders
			text				@MENUS_NAME
			style				0	
			ownerdraw			UI_SELECTEDPLAYER
			// As cycle through playerlist selected player in HUD cycles //
			rect				10 20 200 20
			textalign			0
			textalignx			10
			textaligny			2
			textscale			.25        
			forecolor			0.82 0.84 0.88 1
			visible				1 
		}


		//	GIVE ORDERS TO OTHERS		//	
		itemDef 
		{
			name				orders
			group				grporders
			text				@MENUS_YOU_DECIDE
			descText			@MENUS_YOU_DECIDE
			rect				0 80 200 20
			type				1
			textalign			1
			textalignx			100
			textaligny			2
			textscale			.25        
			forecolor			0.82 0.84 0.88 1
			visible				1 
			mouseenter 
			{
				show			button_glow ;
				setitemrect		button_glow	0 80 200 20 ;
			} 
			mouseEnter
			{
				
			}

			
			mouseExit
			{
				hide			button_glow ;
			}
action 
			{
				play				"sound/interface/button1.mp3" ;
				
				uiScript		voiceOrders "cmd bot_order %d 0" 
			}
			ownerdrawflag		UI_SHOW_LEADER 
		}

