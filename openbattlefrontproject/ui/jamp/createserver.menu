//----------------------------------------------------------------------------------------------
//
//	TOP MENU BUTTONS
//
//----------------------------------------------------------------------------------------------


		// Shared top navigation: Solo Game / Create Game / Join Game / Demos
		itemDef { name nav_solo_glow group topbut style WINDOW_STYLE_SHADER rect 4 100 124 24 background "gfx/menus/menu_buttonback" forecolor 0.82 0.84 0.88 1 visible 0 decoration }
		itemDef { name nav_solo_button group toprow style WINDOW_STYLE_EMPTY type ITEM_TYPE_BUTTON rect 4 100 124 24 text @MENUS_SOLO_GAME descText @MENUS_QUICKSTART_DESC font 3 textscale 0.85 textaligny 0 textalign ITEM_ALIGN_CENTER textstyle 0 textalignx 62 forecolor 0.82 0.84 0.88 1 visible 1 mouseEnter {  show nav_solo_glow } mouseExit { hide nav_solo_glow } action { play "sound/interface/button1.mp3" ;   close all ; open quickgame ; } }
		itemDef { name nav_create_glow group topbut style WINDOW_STYLE_SHADER rect 173 100 124 24 background "gfx/menus/menu_buttonback" forecolor 0.82 0.84 0.88 1 visible 0 decoration }
		itemDef { name nav_create_button group toprow style WINDOW_STYLE_EMPTY type ITEM_TYPE_BUTTON rect 173 100 124 24 text "CREATE GAME" descText "Create Your Own Game" font 3 textscale 0.85 textaligny 0 textalign ITEM_ALIGN_CENTER textstyle 0 textalignx 62 forecolor 0.82 0.84 0.88 1 visible 1 mouseEnter {  show nav_create_glow } mouseExit { hide nav_create_glow } action { play "sound/interface/button1.mp3" ;   close all ; open createserver ; } }
		itemDef { name nav_join_glow group topbut style WINDOW_STYLE_SHADER rect 343 100 124 24 background "gfx/menus/menu_buttonback" forecolor 0.82 0.84 0.88 1 visible 0 decoration }
		itemDef { name nav_join_button group toprow style WINDOW_STYLE_EMPTY type ITEM_TYPE_BUTTON rect 343 100 124 24 text @MENUS_JOIN_SERVER_CAPS descText "Join a server" font 3 textscale 0.85 textaligny 0 textalign ITEM_ALIGN_CENTER textstyle 0 textalignx 62 forecolor 0.82 0.84 0.88 1 visible 1 mouseEnter {  show nav_join_glow } mouseExit { hide nav_join_glow } action { play "sound/interface/button1.mp3" ;   close all ; open joinserver ; } }
		itemDef { name nav_demos_glow group topbut style WINDOW_STYLE_SHADER rect 512 100 124 24 background "gfx/menus/menu_buttonback" forecolor 0.82 0.84 0.88 1 visible 0 decoration }
		itemDef { name nav_demos_button group toprow style WINDOW_STYLE_EMPTY type ITEM_TYPE_BUTTON rect 512 100 124 24 text "@MENUS_DEMOS" descText "Play a Demo" font 3 textscale 0.85 textaligny 0 textalign ITEM_ALIGN_CENTER textstyle 0 textalignx 62 forecolor 0.82 0.84 0.88 1 visible 1 mouseEnter {  show nav_demos_glow } mouseExit { hide nav_demos_glow } action { play "sound/interface/button1.mp3" ;   close all ; open demo ; } }

//----------------------------------------------------------------------------------------------
//	GAME TYPE SELECTION
//----------------------------------------------------------------------------------------------

		
		//	GAME TYPE SELECTION FIELD
		// Do NOT change the name of this item - it's been hacked in code
		// so that if you hit siege it hops over it to the next game type.
		
itemDef 
{
	name				solo_gametypefield_glow
	group				grpsettings
	style				WINDOW_STYLE_SHADER
	rect				320 130 265 32
	background			"gfx/menus/menu_blendbox"
	forecolor			0.82 0.84 0.88 1
	visible				0
	decoration
}

itemDef 
		{
			name				solo_gametypefield
			group				grpsettings
			style				WINDOW_STYLE_EMPTY	
			ownerdraw			UI_NETGAMETYPE
			text				@MENUS_GAME_TYPE
			descText			@MENUS_ALLOWS_YOU_TO_SELECT
			textstyle			0
			rect				320 130 265 32 
			font				3
			textscale			0.8
			textalign			ITEM_ALIGN_LEFT		
			textalignx			0
			textaligny			0 	
			forecolor			0.82 0.84 0.88 1
			visible				1
			border				0
			bordercolor			1 1 1 1
			mouseEnter 
			{ 
				show			solo_gametypefield_glow 
			}
			mouseExit 
			{ 
				hide			solo_gametypefield_glow 
			}

			action 
			{ 
				
			}	
		}

//---------------------------------------------
//	MAP LISTING
//---------------------------------------------
		itemDef 
		{
			name				map
			group				grpTabs
			type				ITEM_TYPE_BUTTON
			text				@MENUS_MAP_NAME_1
			descText			@MENUS_SORT_BY_MAP_NAME
			style				WINDOW_STYLE_EMPTY
			rect				55 130 125 26
      			rect				55 130 240 20
			font				3
			textscale			0.8
			textalign			ITEM_ALIGN_LEFT		
			textalignx			0
			textaligny			0 	
			forecolor			0.82 0.84 0.88 1
      			visible				1 
      			decoration 
			
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	55 130 125 26 ;
			}

			mouseExit
			{
				hide			button_glow ;
			}
action 
			{
				play				"sound/interface/button1.mp3" ; 
				
				uiScript		ServerSort 1
			}
	  	  
		}
		
		
		
		
		itemDef 
		{
			name				maplist
			group				grpsettings
			rect				55 150 265 260
			type				ITEM_TYPE_LISTBOX
			style				WINDOW_STYLE_FILLED
			elementwidth			120
			elementheight			16
			font				4
			textscale			.9
			elementtype			LISTBOX_TEXT
			feeder				FEEDER_ALLMAPS
			textstyle			6
			textalign			3
			textaligny			2
			border				1
			bordercolor			0.4 .4 .4 1
			forecolor			0.82 0.84 0.88 1
			backcolor			0 0 0 5
			outlinecolor 0.38 0.41 0.46 .5
			descText			@MENUS_CHOOSE_YOUR_GAME
			visible				1
			columns				1 2 196 172
		}






