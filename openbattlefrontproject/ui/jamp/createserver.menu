//----------------------------------------------------------------------------------------------
//
//	CREATE SERVER MENU
//
//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"createserver"
		fullScreen				MENU_TRUE				
		rect					0 0 640 480				// Size and position of the menu
		visible					1					// Visible on open
		focusColor			0.82 0.84 0.88 1
		descX				320
		descY					421
		descScale			1
		descColor				0.82 0.84 0.88 1
		descAlignment			ITEM_ALIGN_CENTER


		onESC 
		{ 
			
			close			createserver ;
			open			multiplayerMenu
		}

		onOpen 
		{ 
			setcvartocvar 			password g_password
			uiScript			loadArenas
			hide				accept_alt
			show				accept
			hide				back_alt
			show				back
			hide				grpmessage
			uiScript			setBotButtons
			uiscript			clampmaxplayers
			uiscript			checkservername
		}

			
		
		//----------------------------------------------------------------------------------------------
		//
		//	MENU BACKGROUND
		//
