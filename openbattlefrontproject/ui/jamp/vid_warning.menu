// VIDEO WARNING
{
	menuDef 
	{
		name					"videowarningMenu"
		visible					0
		fullScreen				0				// MENU_TRUE			
		rect					0 0 640 480
		focusColor			0.82 0.84 0.88 1
		outOfBoundsClick							// this closes the window if it gets a click out of the rectangle					// In miliseconds
		descX					320
		descY					421
		descScale				1
		descColor				0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER		
		popup
										
		onESC 
		{ 
			close				"videowarningMenu" ;
			setcvar				"ui_r_modified" 0 ;
			rundeferred ;
		}


		itemDef 
		{
			name				warn_background
			group				none
			style				WINDOW_STYLE_FILLED
			rect				100 100 440 320
			backcolor			0 0 0 1
			border				1
			bordercolor			0.6 0.6 0.6 1
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

//----------------------------------------------------------------------------------------------
//
//	VIDEO WARNING
//
//----------------------------------------------------------------------------------------------
		// Video Warning title
		itemDef 
		{
			name				vidwarn_title
			group				vidwarn
			style				WINDOW_STYLE_SHADER
			background			"gfx/menus/menu_blendbox"
			text				@MENUS_UNAPPLIED_VIDEO_CHANGES
      			rect				120 129 400 20
			font				3
			textscale			1
			textalign			ITEM_ALIGN_CENTER		
			textalignx			200
			textaligny			-3
			forecolor			0.82 0.84 0.88 1
      			visible				1 
      			decoration 
		}


		itemDef 
		{
			name				vidwarn_text1
			group				vidwarn
			text				@MENUS_YOU_HAVE_MADE_CHANGES
			rect				210 230 220 20
			textalign			ITEM_ALIGN_CENTER
			text2aligny			18
			textalignx			110
			font				2
			textscale			1        
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

		itemDef 
		{
			name				vidwarn_text2
			group				vidwarn
			text				@MENUS_APPLY_THESE_CHANGES_OR
			rect				210 250 220 20
			textalign			ITEM_ALIGN_CENTER
			textalignx			110
			font				2
			textscale			1        
			forecolor			0.82 0.84 0.88 1
			visible				1
		}

// DISCARD button - return to Video Data screen

		itemDef 
		{
			name				vidwarn_no
			group				vidwarn
			text				@MENUS_DISCARD
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				180 386 120 24 
			font				2
			textscale			1        
			textalign			ITEM_ALIGN_CENTER
			textalignx			60
			textaligny			-3
			descText			@MENUS_DO_NOT_APPLY_CHANGES
			forecolor			0.82 0.84 0.88 1
			visible				1

			
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	180 386 120 24 ;
			}

			mouseExit
			{
				hide			button_glow ;
			}
action 
			{
				play				"sound/interface/button1.mp3" ; 
				
				close			"videowarningMenu" ;

				setcvar			"ui_r_modified" 0 ;

				rundeferred ;
			}  	  
		}

// APPLY button, use settings

		itemDef 
		{
			name				vidwarn_yes
			group				vidwarn
			text				@MENUS_APPLY
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				340 386 120 24 
			font				2
			textscale			1        
			textalign			ITEM_ALIGN_CENTER
			textalignx			60
			textaligny			-3
			descText			@MENUS_APPLY_CHANGES_AND_THEN
			forecolor			0.82 0.84 0.88 1
			visible				1

			
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	340 386 120 24 ;
			}

			mouseExit
			{
				hide			button_glow ;
			}
action 
			{
				play				"sound/interface/button1.mp3" ; 
				

				uiScript		updatevideosetup ;

//				uiScript		setvid1data	setupMenu ;		// Set video settings
				close			all
			}  	  
		}
	
	

		// Shared hover glow for text buttons that use dynamic setitemrect.
		itemDef
		{
			name				button_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				0 0 0 0
			background			"gfx/menus/menu_buttonback"
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}
}	
}





