			textalignx 			0
			textaligny 			-4
			font				2
			textscale			0.7
			forecolor			0.82 0.84 0.88 1
			outlinecolor 		0.38 0.41 0.46 .5
			backcolor 			0 0 0 0
			border 				1
			bordercolor 		0 0 0 0
