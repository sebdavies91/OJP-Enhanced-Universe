		{
			name				blue_bar1
			type				ITEM_TYPE_INTSLIDER
			text				"Sab1 B"
			cvarint				"ui_sab1_b" 255 1 255
			rect				20 145 140 30
	   		textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			-4
			font 				2
			textscale 			0.7
			forecolor			0.82 0.84 0.88 1
			visible				1
			descText			"@OBP_MENUS_RGBSABERS_SETUP_SLIDER_BLUE1"
