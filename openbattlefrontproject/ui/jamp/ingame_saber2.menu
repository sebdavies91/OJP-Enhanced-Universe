		// Saber preview models, adapted from the non-ingame saber2 RGB page.
		itemDef
		{
			name				saber
			group				models
			type 				ITEM_TYPE_MODEL
			rect				-5 -110 640 615
			asset_model			"models/weapons2/saber_reborn/saber_w.glm"
			isSaber				1
			model_angle			180
			model_rotation		20
			model_g2mins		0 0 0
