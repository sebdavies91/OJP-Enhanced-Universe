//[NewMenus]
//-----------------------------------
// In-game RGB Saber Setup overlay
//-----------------------------------
// This mirrors the ingame_player/ingame_player2 overlay flow:
// ingame_saber stays alive underneath, while this right-side overlay
// covers its content area and can be closed by the LIGHTSABER button.
{
	menuDef 
	{
		name						"ingame_saber2"
		visible						0
		fullscreen					0
//		outOfBoundsClick										// keep disabled, like ingame_player2
		rect						125 45 515 400
		focusColor			0.82 0.84 0.88 1
		style						1
		border						1
		descX						320
		descY					421
		descScale					1
		descColor			0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER		

		onOpen
		{
			uiScript				setsaberboxesandhilts
			setcvar 				ui_saber_color	 "rgb"
			setcvar 				ui_saber2_color	 "rgb"
			uiScript  			"saber_hilt"
			uiScript  			"saber_color"
			uiScript  			"saber2_hilt"
			uiScript  			"saber2_color"
			uiScript				getsaberhiltinfo
			hide					highlights
		}
		onClose
		{
			uiScript 			"updatesabercvars"
			uiScript  			"saber_color"
			uiScript  			"saber2_color"
			hide					highlights
		}

		// Opaque right-side content backdrop, matching the custom character overlay philosophy.
		itemDef
		{
			name				saber2backdrop
			style				WINDOW_STYLE_FILLED
			rect				3 8 510 390
			backcolor			0.1 0.1 0.1 0.95
			forecolor			0.82 0.84 0.88 1
			border				0
			visible				1
			decoration
		}

		itemDef
		{
			name 				sabertitle
			style				WINDOW_STYLE_FILLED
			text				"Choose Your RGB Color"
			rect				3 6 508 21
			textalign			ITEM_ALIGN_CENTER		
			textalignx			254
			textaligny			-2
			outlinecolor		.5 .5 .5 .5
			backcolor			0.1 0.1 0.1 0.5
			font				3
			textscale			1
			forecolor			0.82 0.84 0.88 1
			border				0
			bordercolor 		0 0 0 0
			visible				1
			decoration
		}

		itemDef
		{
			name				rgb_title
			text				"RGB Saber Colors"
			style				WINDOW_STYLE_EMPTY
			rect				20 43 300 20
			font				3
			textscale			0.75
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			0
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

		// LIGHTSABER return button, same visual placement as CHARACTER in ingame_player2.
		itemDef
		{
			name				lightsaberreturn
			text				"LIGHTSABER"
			descText			"Return to lightsaber selection"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				435 342 160 15
			font				2
			textscale			0.8
			textalign			ITEM_ALIGN_RIGHT
			textstyle			3
			forecolor			0.82 0.84 0.88 1
			visible				1
			
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	435 342 160 15 ;
			}

			mouseExit
			{
				hide			button_glow ;
			}
action
			{
				play				"sound/interface/button1.mp3" ;
				
				close				ingame_saber2 ;
			}
		}

		//------------------------------- SABER 1 RGB CONTROLS
		itemDef
		{
			name				rgb_saber1_title
			text				"SABER 1"
			style				WINDOW_STYLE_EMPTY
			rect				20 180 180 20
			font				3
			textscale			0.7
			textalign			ITEM_ALIGN_CENTER
			textalignx			90
			textaligny			0
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

