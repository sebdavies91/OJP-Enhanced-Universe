		itemDef 
		{
			type 				ITEM_TYPE_EDITFIELD
			style 				0
			text 				"B:"
			cvar 				"ui_sab1_b"
			maxchars 			3
			maxPaintChars 		3 
			rect 				170 145 30 20
			textalign			ITEM_ALIGN_LEFT		
			textalignx 			0
			textaligny 			-4
			font				2
			textscale			0.7
