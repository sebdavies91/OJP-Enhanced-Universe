//[NewMenus]
//-------------------------------------------
// INGAME MENU 
//
// This is the main menu of the ingame menus.
//
//-------------------------------------------
{
	assetGlobalDef 
	{
		font					"ergoec" 18				// font
		smallFont				"ocr_a" 18				// font
		bigFont					"anewhope" 20			// font
		small2Font				"arialnb" 	14	
		cursor					"obp/menu/cursor"			// cursor	
		gradientBar				"ui/assets/gradientbar2.tga"	// gradient bar
		itemFocusSound			"sound/interface/menuroam.wav"		// sound for item getting focus (via keyboard or mouse )

		fadeClamp				1.0					// sets the fadeup alpha
		fadeCycle				1					// how often fade happens in milliseconds
		fadeAmount				0.1					// amount to adjust alpha per cycle

		shadowColor				0.1 0.1 0.1 0.25			// shadow color
		precacheSound
		{
			"sound/interface/choose_color.wav" ;
			"sound/interface/choose_head.wav" ;
			"sound/interface/choose_torso.wav" ;
			"sound/interface/choose_saber.wav" ;
			"sound/interface/choose_hilt.wav" ;
			"sound/interface/choose_blade.wav" ;
			"sound/interface/transition.wav"  ;
			"sound/interface/button1.wav" ;
			"sound/interface/sub_select.wav" ;
		}
	}
							   
	menuDef 
	{
		name					"ingame"
		visible					1
		fullScreen				0
		//outOfBoundsClick										// disabled so top bar cannot close/block profile menus
		rect					0 0 640 45
		focusColor			0.82 0.84 0.88 1
		disableColor			0.82 0.84 0.88 1

		descX					320
		descY					421
		descScale				1
		descColor			0.82 0.84 0.88 1
		descAlignment			ITEM_ALIGN_CENTER

		onOpen  
		{ 
			uiScript 			setBotButton
		}




		itemDef
		{
			name				background_pic
			group				none
			style				WINDOW_STYLE_FILLED
			rect			0 0 639 45
			backcolor			0.1 0.1 0.1 0.5
			border				1
			bordercolor			.33 .33 .33 1
			forecolor			0.82 0.84 0.88 1
			visible 			1
			decoration
		}

		itemdef
		{
			name				about
			text				@MENUS_ABOUT
			descText			@MENUS_ABOUT
			rect				5 0 70 32
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_FILLED
			font				2
			textscale			0.8
			textstyle			0
			textalign			ITEM_ALIGN_CENTER
			textalignx			35
			textaligny			3
			forecolor			0.82 0.84 0.88 1
			backcolor			0 0 0 0
			visible				1
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	5 0 70 32 ;
			}

			
			mouseExit
			{
				hide			button_glow ;
			}
action 
			{
				play				"sound/interface/button1.mp3" ; 
				
				open			ingame_about ;
				close			ingame_playerforce1 ;
				close			ingame_playerforce2 ;				
				close			ingame_player2 ;
				close			ingame_player ;
				close			ingame_playergunnery1 ;
				close			ingame_playergunnery2 ;
				close			ingame_playergunnery3 ;
				close			ingame_saber ;
				close			ingame_playergadgets1 ;
				close			ingame_playergadgets2 ;
				close			ingame_playerabilities ;
				close			ingame_playervehicles ;	
			}
		}



		itemDef 
		{
			name				class
			text				@MENUS_JOIN
			descText			@MENUS_JOIN
			type				1
			style				WINDOW_STYLE_FILLED
			rect				85 0 70 32
			font				2
			textscale			0.8
			textstyle			0
			textalign			ITEM_ALIGN_CENTER
			textalignx         	35
			textaligny			3
			forecolor			0.82 0.84 0.88 1
			backcolor			0 0 0 0
			visible			1
			cvartest			"g_gametype"
			showcvar			{ "7" }
