//----------------------------------------------------------------------------------------------
//	RULES
//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"rulesMenu_items"
		fullScreen				MENU_TRUE				
		rect					0 0 640 480							// Size and position of the menu
		visible					0					
		focusColor			0.82 0.84 0.88 1
		descX					320
		descY					421
		descScale				1
		descColor				0.82 0.84 0.88 1
		descAlignment			ITEM_ALIGN_CENTER		

		onOpen 
		{
			hide			gamedesc ;
			show			medpac_desc ;

			setitemcolor		game_submenu	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		medpacmenubutton	forecolor 0.82 0.84 0.88 1 ;
		}								

		onESC 
		{ 
				
				close			all ; 
				open			rulesMenu
		}
	
