//[NewMenus]
//----------------------------------------------------------------------------------------------
// INGAME_JOIN MENU 
//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"ingame_join"
		visible					1
		fullScreen				0
		outOfBoundsClick						// this closes the window if it gets a click out of the rectangle
		rect					55 45 128 128
		focusColor			0.82 0.84 0.88 1

		descX					320
		descY					421
		descScale				1
		descColor			0.82 0.84 0.88 1
		descAlignment			ITEM_ALIGN_CENTER


		// Overall window backdrop
		itemDef 
		{
			name				background_pic
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 0 128 128
			border				1
			bordercolor			.33 .33 .33 1
			backcolor			0.1 0.1 0.1 0.5
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}
		
		//---------------------------------
		// TEAM JOIN
		//---------------------------------
		itemDef 
		{
			name				team
			text				@MENUS_AUTO_TEAM
			descText			@MENUS_AUTO_TEAM
			type				1
			style				2	
			rect				2 4 124 30   
			textalign			ITEM_ALIGN_CENTER
			textalignx			62
			textaligny			0     
			font				2
			textscale			0.7
			forecolor			0.82 0.84 0.88 1
			cvarTest			"ui_about_gametype"
			showCvar 
			{ 
				"6" ; 
				"7" ; 
				"8" ; 
				"9"
			}
			visible				1 
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	2 4 124 30 ;
			}

			action 
			{
				play				"sound/interface/button1.mp3" ; 
				
				exec			"cmd team free" ; 
				uiScript		closeingame 
			}
			mouseEnter 
			{ 
			}
			mouseExit 
			{
				hide			button_glow ;
			}
		}

