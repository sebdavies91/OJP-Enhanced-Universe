//[NewMenus]
//------------------------------------------------------------------------------------------------
// PLAYER SETUP MENU  - ingame_player
//
//	Choose player skin, name
//	Choose light saber
//	Allocate force powers
//
//	g_gametypes
//		"Free For All" 		0
//		"Duel" 			3
//		"Power Duel" 		4
//		"Team FFA" 		6 
//		"Siege" 		7
//		"Capture the Flag" 	8
//
//	ui_net_gametype
//		0 = FFA
//		1 = DUEL
//		2 = POWER DUEL
//		3 = TEAM FFA
//		4 = SIEGE
//		5 = CTF
//------------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name						"ingame_player"
		visible						0
		fullscreen					0
//		outOfBoundsClick										// this closes the window if it gets a click out of the rectangle
		rect						0 45 640 480
		focusColor			0.82 0.84 0.88 1
		style						1
		border						1
		descX						320
		descY					421
		descScale					1
		descColor			0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER		
		onOpen  
		{ 
uiScript				update "ui_GetName"
			uiScript				updateForceStatus
			hide					highlights
			
			show					startpage ;
			hide					name ;
			hide					character ;
			setitemcolor		namebutton	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		characterbutton	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		force1button	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		force2button	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		lightsaberbutton	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		gunnery1button	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		gunnery2button	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		gunnery3button	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		gadgets1button	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		gadgets2button	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		abilitiesbutton	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		vehiclesbutton	forecolor 0.82 0.84 0.88 1 ;
		}
		onClose 
		{ 
			uiScript				update "ui_SetName"
			uiScript				updateForceStatus
			hide					highlights
			close					ingame_playerforce1
			close					ingame_playerforce2
		}
		
//------------------------------------------------------------------------------------------------
// Overall window backdrop
//------------------------------------------------------------------------------------------------
		itemDef 
		{
			name				background_pic
			group				none
			style				WINDOW_STYLE_FILLED
			rect				0 3 120 399
			border				1
			bordercolor			.33 .33 .33 1
			backcolor			0.1 0.1 0.1 0.5
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}
		
		itemDef
		{
			name				background2
			group				none
			style				WINDOW_STYLE_FILLED
			rect			125 3 514 399
			border				1
			bordercolor			.33 .33 .33 1
			backcolor			0.1 0.1 0.1 0.5
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}
		
		itemDef
		{
			name				background3
			group				none
			style				WINDOW_STYLE_FILLED
			rect			0 405 639 30
			border				1
			bordercolor			.33 .33 .33 1
			backcolor			0.1 0.1 0.1 0.5
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration			
		}
		
//------------------------------------------------------------------------------------------------
// Player Configuration
//------------------------------------------------------------------------------------------------

		// Player Configuration title		
		itemDef 
		{
			name				playerconfigtitle
			style				WINDOW_STYLE_FILLED
			text				@MENUS_PROFILE_LOWER
			rect				3 6 116 21
			textalign			ITEM_ALIGN_CENTER		
			textalignx			58
			textaligny			-2
			outlinecolor		.5 .5 .5 .5
			backcolor			0.1 0.1 0.1 0.5
			font				3
			textscale			1
			forecolor			0.82 0.84 0.88 1
			border				0
			bordercolor			.33 .33 .33 1
			visible				1 
		}
		
//------------------------------------------------------------------------------------------------
// Main Buttons
//------------------------------------------------------------------------------------------------

		// Name Button
		itemDef
		{
			name				namebutton
			group				none
			text				"General"
			descText			"Open general profile settings"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				15 40 90 15
			font				3
			textscale			0.7
			textalign			ITEM_ALIGN_CENTER
			textalignx			44
			textaligny			0
			textstyle			0
			forecolor			0.82 0.84 0.88 1
			visible				1
			
			
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	15 40 90 15 ;
			}

			mouseExit
			{
				hide			button_glow ;
			}
action
			{
				play				"sound/interface/button1.mp3" ;
				
				hide			startpage ;
				show			name ;
				hide			character ;
				close			ingame_playerforce1 ;
				close			ingame_playerforce2 ;
				close			ingame_player2 ;
				close			ingame_playergunnery1 ;
				close			ingame_playergunnery2 ;
				close			ingame_playergunnery3 ;
				close			ingame_saber ;
				close			ingame_playergadgets1 ;
				close			ingame_playergadgets2 ;
				close			ingame_playerabilities ;
				close			ingame_playervehicles ;				
				setitemcolor		namebutton	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		characterbutton	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		force1button	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		force2button	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		lightsaberbutton	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		gunnery1button	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		gunnery2button	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		gunnery3button	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		gadgets1button	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		gadgets2button	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		abilitiesbutton	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		vehiclesbutton	forecolor 0.82 0.84 0.88 1 ;
			}
		}
		
