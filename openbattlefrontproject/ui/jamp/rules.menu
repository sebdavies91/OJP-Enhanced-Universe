//----------------------------------------------------------------------------------------------
//	MULTIPLAYER RULES
//
//	Rules main menu.From here you can get at any of the rules menus.
//
//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"rulesMenu"
		fullScreen				1				
		rect					0 0 640 480						// Size and position of the menu
		visible				0					
		focusColor			0.82 0.84 0.88 1
		descX					320
		descY					421
		descScale				1
		descColor				0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER		

		onOpen 
		{
			setcvar				"ui_rules_backout" 0 ;
		}								

		onESC 
		{ 
				
				close			all ; 
				open			mainMenu
		}
	

		//----------------------------------------------------------------------------------------------
		//
		//	MENU BACKGROUND
		//
		//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name				really_background
			group				none
			style				WINDOW_STYLE_SHADER
			rect				156 154 320 240
			background			"gfx/menus/main_centerblue"
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

		itemDef 
		{
			name				background_text
			group				none
			style				WINDOW_STYLE_SHADER
