//----------------------------------------------------------------------------------------------
//	TOP MENU BUTTONS
//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name				button_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				516 445 120 24
			background			"gfx/menus/menu_buttonback"
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}
		
		// Big button "Play"
		itemDef
		{
			name				playbutton_glow
			group				none
			style				WINDOW_STYLE_SHADER
			rect				7 126 130 24
			background			"gfx/menus/menu_buttonback"
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}

		itemDef 
		{
			name				playbutton
			group				toprow
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect				7 126 130 24
			text				@MENUS_PLAY
			descText			@MENUS_START_PLAYING_NOW
			font				3
			textscale			1.1
			textaligny			0
			textalign			ITEM_ALIGN_CENTER
			textstyle			0
			textalignx			65
			forecolor			0.82 0.84 0.88 1
			visible			1

			mouseEnter 
			{
				show			button_glow  
				show			playbutton_glow 
				setitemrect		button_glow	7 126 130 24
			}
			mouseExit 
			{ 
				hide			playbutton_glow 
			}	  	  
			action 
			{
				play				"sound/interface/button1.mp3" ; 
				
				close			all ; 
				open			multiplayermenu 
			}
		}

		// Big button "PLAYER PROFILE"
