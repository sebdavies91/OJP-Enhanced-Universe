//----------------------------------------------------------------------------------------------
// MP SABER RGB MENU - second saber menu page, modeled after player/player2 flow
//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"saberMenu2"
		fullScreen				1
		rect					0 0 640 480
		visible					1
		focusColor			0.82 0.84 0.88 1
		descX					320
		descY					421
		descScale				1		
		descColor				0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER
	
		onOpen
		{ 
			uiScript			setsaberboxesandhilts			
			uiScript  			"getsabercvars"
			setcvar 		ui_saber_color	 "rgb"
			setcvar 		ui_saber2_color	 "rgb"
			uiScript  			"saber_hilt"
			uiScript  			"saber_color"
			uiScript  			"saber2_hilt"
			uiScript  			"saber2_color"
			uiScript			getsaberhiltinfo
			show 			rgboptions
		}
									
		onESC 
		{ 
				
				close			saberMenu2
				open			profileMenu
		}


