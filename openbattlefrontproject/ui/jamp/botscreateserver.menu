		{
			name				next_button
			text				@MENUS_BEGIN
			descText			@MENUS_START_SERVER
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect			512 445 124 32
			font				3
			textscale			0.9
			textalignx			62
			textaligny			0
			textalign			ITEM_ALIGN_CENTER
			textstyle			3
			forecolor			0.82 0.84 0.88 1
			visible				1
			mouseEnter {  show next_button_glow }
			mouseExit { hide next_button_glow }
			action
			{
				play				"sound/interface/button1.mp3" ;
				
				uiScript setSiegeNoBots ;
				uiScript weaponDisable ;
				uiScript StartServer ;
				setcvartocvar password g_password ;
				close			botscreateserver ;
			}
		}

