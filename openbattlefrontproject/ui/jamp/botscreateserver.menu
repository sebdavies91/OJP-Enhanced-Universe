			style				WINDOW_STYLE_SHADER
			rect			4 445 124 32
			background			"gfx/menus/menu_buttonback"
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}

		itemDef
		{
			name				back_button
			text				@MENUS_BACK
			descText			"Back to rules"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect			4 445 124 32
			font				3
			textscale			0.9
			textalignx			62
			textaligny			0
			textalign			ITEM_ALIGN_CENTER
			textstyle			3
			forecolor			0.82 0.84 0.88 1
			visible				1
			mouseEnter {  show back_button_glow }
			mouseExit { hide back_button_glow }
			action
			{
				play				"sound/interface/button1.mp3" ;
				
				close			botscreateserver ;
				open			advancedcreateserver
			}
		}

itemDef
		{
			name				next_button_glow
