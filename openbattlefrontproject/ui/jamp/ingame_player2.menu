//[NewMenus]
//-----------------------------------
// Custom Player
//-----------------------------------
//
// This menu works the same as the ingame_player2.menu.
//
{
	menuDef 
	{
		name						"ingame_player2"
		visible						0
		fullscreen					0
//		outOfBoundsClick										// this closes the window if it gets a click out of the rectangle
		rect						125 45 515 400
		focusColor			0.82 0.84 0.88 1
		style						1
		border						1
		descX						320
		descY					421
		descScale					1
		descColor			0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER		
		onOpen  
		{
			uiScript  				"getcharcvars"
			uiScript  				"character"
			uiScript				updateForceStatus
			hide					highlights
		}
		onClose 
		{ 
			uiScript				updateForceStatus 
			hide					highlights
			uiScript				"updatecharmodel"
		}
		
		// Backdrop for the custom character overlay.
		// This covers the still-open parent Character page without closing it,
		// so the CHARACTER button can simply close this overlay and return safely.
		itemDef
		{
			name				player2backdrop
			style				WINDOW_STYLE_FILLED
			// Keep this inside the normal ingame_player content margins.
			// Do not cover the outer menu border/sidebar/bottom margin.
			rect				3 8 510 390
			backcolor			0.1 0.1 0.1 0.95
			forecolor			0.82 0.84 0.88 1
			border				0
			visible				1
			decoration
		}
		
//---------------------------------------------
//	CUSTOM CHARACTER
//---------------------------------------------
		// Custom Character Title
		itemDef
		{
			name 				charactertitle
			style				WINDOW_STYLE_FILLED
			text				"Choose Your Custom Character"
			rect			2 6 516 21
			textalign			ITEM_ALIGN_CENTER		
			textalignx			255
			textaligny			-2
			outlinecolor		.5 .5 .5 .5
			backcolor			0.1 0.1 0.1 0.5
			font				3
			textscale			1
			forecolor			0.82 0.84 0.88 1
			border				0
			bordercolor			.33 .33 .33 1
			visible				1 
		}
		
		itemDef
		{
			name				descbackground
			style				0
			rect				-120 390 520 20
			backcolor			0.1 0.1 0.1 0.5
			forecolor			0.82 0.84 0.88 1
			border				0
			visible				1
		}
		

		itemDef
		{
			name				backtocharacter
			text				"CHARACTER"
			descText			"Back to character selection"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				435 342 160 15
			font				2
			textscale			0.8
			textalign			ITEM_ALIGN_RIGHT
			textstyle			3
			forecolor			0.82 0.84 0.88 1
			visible				1
			
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	435 342 160 15 ;
			}

			mouseExit
			{
				hide			button_glow ;
			}
action
			{
				play				"sound/interface/button1.mp3" ;
				
				close			ingame_player2 ;
			}
		}

		// Character model
		itemDef
		{
			name				character
			group				models
			type 				ITEM_TYPE_MODEL
			rect				260 100 200 225
			model_g2anim 		"BOTH_WALK1"
			asset_model			"ui_char_model"
			model_angle			180
			//mins maxs format is apparently z x y (hmmm... y x z?)
			model_g2mins		-30 -15 -14
			model_g2maxs		20 15 30
			model_rotation		50
			model_fovx			50
			model_fovy			50
			isCharacter			1
			visible				1
			decoration
		}
		
		//////////////////
		// SPECIES BUTTON
		//////////////////
		itemDef
		{
			name				species
			group				none
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				65 45 100 20
			forecolor			0.82 0.84 0.88 1
			text				@MENUS_SPECIES
			descText			@MENUS_SPECIES_DESC
			textalign			ITEM_ALIGN_RIGHT
			textalignx			0
			textaligny			0
			textstyle			0
			font				2
			textscale 			0.7
			visible 			1
			decoration
		
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	65 45 100 20 ;
			}

			mouseExit
			{
				hide			button_glow ;
			}
}

		itemDef 
		{
			name				speciesbut
			group				none
			text				" "
			descText			@MENUS_CHOOSE_SPECIES
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY
			rect				185 45 185 20
			font				2
			textscale			.7
			textaligny			0
			textalign			ITEM_ALIGN_RIGHT
			textstyle			0
			textalignx			0
			backcolor			0 0 0 0
			forecolor			0.82 0.84 0.88 1
			feeder				19	//FEEDER_PLAYER_SPECIES
			cvar				"ui_char_model"
			cvarStrList			feeder

			visible			1
			mouseEnter
			{
				
			}

			 
			action 
			{
				play				"sound/interface/button1.mp3" ;
				
				uiScript 		"characterchanged"
				uiScript 		"resetcharacterlistboxes"
			}
		}

		
		////////////////////
		// COLOR TINT AREA
		////////////////////
		itemDef
		{
			name				colorbox
			group				tints
			type				ITEM_TYPE_LISTBOX
			style				WINDOW_STYLE_FILLED
			elementwidth		32
			elementheight		32
			elementtype			1 			//LISTBOX_IMAGE
			feeder				23		//FEEDER_COLORCHOICES
			horizontalscroll
			border				1
			bordersize			1
			backcolor			0.1 0.1 0.1 0.5
			bordercolor			.33 .33 .33 1
			rect				20 100 288 50
			visible				1
			mouseEnter
			{
				
			}

			action 
			{
				play				"sound/interface/button1.mp3" ;
				}
		}
		
		// RGB Player
		
		itemDef 
		{
			name				colorpresetbut
			group				none
			text				"Presets"
			descText			"Preset Color Menu."
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				140 75 70 16
			font				2
			textscale			.7
			textaligny			0
			textalign			ITEM_ALIGN_RIGHT
			textstyle			0
			textalignx			0
			backcolor			0 0 0 0
			forecolor			0.82 0.84 0.88 1
			visible				1

			
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	140 75 70 16 ;
			}

			mouseExit
			{
				hide			button_glow ;
			}
action 
			{
				play				"sound/interface/button1.mp3" ;
				
				show			tints
				hide			tints2
				
				setitemcolor		colorrgbbut	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		colorpresetbut	forecolor 0.82 0.84 0.88 1 ;
			}
		}

		itemDef 
		{
			name				colorrgbbut
			group				none
