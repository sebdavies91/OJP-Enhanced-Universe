		//----------------------------------------------------------------------------------------------
		//
		//	TOP MENU BUTTONS
		//
		//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name				playerbutton_glow
			group				topbut
			style				WINDOW_STYLE_SHADER
			rect			4 100 124 24
			background			"gfx/menus/menu_buttonback"
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}

		itemDef 
		{
			name				playerbutton
			group				topbut
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect			4 100 124 24
			text				"CHARACTER"

			descText			"Choose your character"
			font				3
			textscale			0.85
			textaligny			0
			textalign			ITEM_ALIGN_CENTER
			textstyle			0
			textalignx			62
			forecolor			0.82 0.84 0.88 1
			visible				1
			mouseEnter 
			{  
				show			playerbutton_glow 
			}
			mouseExit 
			{ 
				hide			playerbutton_glow 
			}	  	  
			action 
			{
				play				"sound/interface/button1.mp3" ; 
				

				close			all ; 
				open			playermenu 
			}
		}

		itemDef 
		{
			name				lightsaberbutton_glow
			group				topbut
			style				WINDOW_STYLE_SHADER
			rect			512 100 124 24
			background			"gfx/menus/menu_buttonback"
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}

		itemDef 
		{
			name				lightsaberbutton
			group				toprow
			text				"LIGHTSABER"

			descText			"Choose your lightsaber"
			style				WINDOW_STYLE_EMPTY
			type				ITEM_TYPE_BUTTON
			rect			512 100 124 24
			textaligny			0
			font				3
			textscale			0.85
			textalign			ITEM_ALIGN_CENTER
			textstyle			0
			textalignx			62
			forecolor			0.82 0.84 0.88 1
			visible				1
			mouseEnter 
			{  
				show			lightsaberbutton_glow 
			}
			mouseExit 
			{ 
				hide			lightsaberbutton_glow 
			}	  	  
			action 
			{
				play				"sound/interface/button1.mp3" ; 
				


				close			all
				open			sabermenu
			}
		}



