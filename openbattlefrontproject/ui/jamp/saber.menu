//----------------------------------------------------------------------------------------------
//
// MP SABER CREATION MENU - called from main menu at the the start of a new game, 
//     and also when player is allowed to upgrade is style and choose a new saber
//
//----------------------------------------------------------------------------------------------
{
						   
	menuDef 
	{
		name					"saberMenu"
		fullScreen				1						// MENU_TRUE				
		rect					0 0 640 480					// Size and position of the menu
		visible					1						// Visible on open
		focusColor			0.82 0.84 0.88 1
		descX					320
		descY					421
		descScale				1		
		descColor				0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER
	
		onOpen
		{ 
			uiScript			setsaberboxesandhilts			
			uiScript  			"getsabercvars"
			uiScript  			"saber_hilt"
			uiScript  			"saber_color"
			uiScript  			"saber2_hilt"
			uiScript  			"saber2_color"
			setitemcolor		typebut_single	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		typebut_dual	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		typebut_staff	forecolor 0.82 0.84 0.88 1 ;
			uiScript			getsaberhiltinfo
			show 			typebut
			show 			typebut_single
			show 			typebut_dual
			show 			typebut_staff
			show 			hilttype
			show			hiltbut
			show			hiltbut1
			show			hiltbut2
			show 			hiltbut_staves
			show			sabericons
			show			sabericons2
			show			box1
			show 			box3top
			show 			box3middle
			show 			box3bottom
			hide 			rgboptions
		}
									
		onESC 
		{ 
				
				close			saberMenu
				open			profileMenu
		}


		//----------------------------------------------------------------------------------------------
		//
		//	MENU BACKGROUND
		//
		//----------------------------------------------------------------------------------------------
