//----------------------------------------------------------------------------------------------
// Tchouky's RGB menu
//----------------------------------------------------------------------------------------------

		itemDef 
		{
			name				rgbsetupbutton
			group				none
			text				"@OBP_MENUS_RGBSABERS_SETUP"
			descText			"@OBP_MENUS_RGBSABERS_SETUP_DESC"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect			390 160 150 24
			font				3
			textscale			0.8
			textstyle			0
			textalign			ITEM_ALIGN_CENTER
			textalignx			75
			textaligny			0
			forecolor			0.82 0.84 0.88 1
			visible			0
			mouseEnter 
			{  
				setitemcolor		rgbsetupbutton	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		rgbsetupbutton bordercolor 0.38 0.41 0.46 1 ;
			}
			mouseExit 
			{ 
				setitemcolor		rgbsetupbutton	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		rgbsetupbutton bordercolor 0.38 0.41 0.46 1 ;
			}	  	  
			action 
			{
				play				"sound/interface/button1.mp3" ;
				hide 			typebut
				hide 			typebut_single
				hide 			typebut_dual
				hide 			typebut_staff
				hide 			hilttype
				hide			hiltbut
				hide			hiltbut1
				hide			hiltbut2
				hide			hiltbut_staves
				hide			box1
				hide 			box3top
				hide 			box3middle
				hide 			box3bottom
				hide 			sabericons
				hide 			sabericons2
				show 			rgboptions
				setcvar 		ui_saber_color	 "rgb"
				setcvar 		ui_saber2_color	 "rgb"

			}
		}

		itemDef 
		{
			name				rgbsetupapply
			group				rgboptions
			text				"@MENUS_APPLY"
			descText			"@OBP_MENUS_RGBSABERS_SETUP_APPLY_DESC"
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				400 260 100 24
			font				4
			textscale			1.4
