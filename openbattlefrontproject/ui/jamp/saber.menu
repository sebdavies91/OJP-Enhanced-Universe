		itemDef 
		{
			name				typebut_single
			group				none
			text				@MENUS_SINGLESABER
			descText			@MENUS_SINGLESABER_DESC
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect			190 130 140 20
			font				3
			textscale			0.8
			textstyle			0
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			0
			forecolor			0.82 0.84 0.88 1
			visible				1
			mouseEnter 
			{  
				show			typebut_single_glow
			}
			mouseExit 
			{ 
				hide			typebut_single_glow
			}
			action 
			{
				play				"sound/weapons/saber/saberon.mp3" ;
				setcvar			ui_saber_type	"single"
				uiScript  		"saber_type"
				setcvar			ui_saber	"single_1"
				setcvar			ui_saber2	"none"
				uiScript  		"saber_hilt"
				uiScript  		"saber_color"
				uiScript  		"saber2_hilt"
				uiScript  		"saber2_color"
				setitemcolor		typebut_single	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		typebut_dual	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		typebut_staff	forecolor 0.82 0.84 0.88 1 ;
//				transition2 		box2middle 212 126 219 0 20 5
//				transition2 		box2bottom 212 126 219 60 20 5
				transition2 		box3middle 418 126 219 0 20 5
				transition2 		box3bottom 418 126 219 60 20 5
				show 			sabstyle
				//transition2 		saber 0 "-80" 640 615 20 10
			}
		}

