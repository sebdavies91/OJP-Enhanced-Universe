//----------------------------------------------------------------------------------------------
//
//	profile QUICK SERVER MENU
//
//	Allows player to choose quickly game server rules
//		This is the second screen in the quick game series.
//----------------------------------------------------------------------------------------------
{
	menuDef 
	{
		name					"quickgame2"
		fullScreen				MENU_TRUE				
		rect					0 0 640 480				// Size and position of the menu
		visible					1					// Visible on open
		focusColor			0.82 0.84 0.88 1
		descX					320
		descY					421
		descScale				1
		descColor				0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER		

		onESC 
		{ 
				
				close			quickgame2
				open			quickgame 
		}

		onOpen 
		{ 
			hide				accept_alt ; 
			show				accept ;
			hide				back_alt ;
			show				back ;
			hide				grpmessage 
		}

