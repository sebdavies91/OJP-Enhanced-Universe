		itemDef 
		{
			name				newgamebutton_glow
			group				topbut
			style				WINDOW_STYLE_SHADER
			rect			4 100 124 24
			background			"gfx/menus/menu_buttonback"
			forecolor			0.82 0.84 0.88 1
			visible				0
			decoration
		}

		itemDef 
		{
			name				newgamebutton
			group				toprow
			text				@MENUS_PLAY
			descText			@MENUS_START_PLAYING_NOW
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect			4 100 124 24
			font				3
			textscale			0.85
			textaligny			0
			textalign			ITEM_ALIGN_CENTER
			textstyle			0
			textalignx			62
			backcolor			0 0 0 0
			forecolor			0.82 0.84 0.88 1
			visible				1
			mouseEnter 
			{  
				show			newgamebutton_glow 
			}
			mouseExit 
			{ 
				hide			newgamebutton_glow 
			}
			action 
			{
				play				"sound/interface/button1.mp3" ; 
				
				defer			VideoSetup	videowarningMenu
				close			all ;
				open			multiplayermenu
			}
		}


