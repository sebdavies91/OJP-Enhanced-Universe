			textaligny			-2
			outlinecolor		.5 .5 .5 .5
			backcolor			0.1 0.1 0.1 0.5
			font				3
			textscale			1
			forecolor			0.82 0.84 0.88 1
			border				0
			bordercolor			.33 .33 .33 1
			visible				1  
		}
		
		itemDef
		{
			name				descbackground
			style				0
			rect				5 390 520 20
			backcolor			0.1 0.1 0.1 0.5
			forecolor			0.82 0.84 0.88 1
			border				0
			visible				1
		}
		
//----------------------------------------------------------------------------------------------
// SABER TYPE BUTTONS (standard, dual, two handed)
//----------------------------------------------------------------------------------------------
		itemDef 
		{
			name				typebut
			group				none
			text				@MENUS_SABER_TYPE
			descText			@MENUS_SABER_TYPE_DESC
			style				WINDOW_STYLE_EMPTY
			rect				55 30 100 24
			font				2
			textscale			.7
			textstyle			0
			textalignx			0
			textaligny			0
			textalign			ITEM_ALIGN_LEFT
			backcolor			0 0 0 0
			forecolor			0.82 0.84 0.88 1
			visible				1
			decoration
		}

		itemDef 
		{
			name				typebut_single
			group				none
			text				@MENUS_SINGLESABER
			descText			@MENUS_SINGLESABER_DESC
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				155 31 100 15
			font				2
			textscale			0.7
			textstyle			0
			textalign			ITEM_ALIGN_LEFT
			textalignx			0
			textaligny			0
			forecolor			0.82 0.84 0.88 1
			visible				1
			
			mouseEnter
			{
				show			button_glow ;
				setitemrect		button_glow	155 31 100 15 ;
			}

			mouseExit
			{
				hide			button_glow ;
			}
action 
			{
				play				"sound/weapons/saber/saberon.mp3" ;
				
				setcvar			ui_saber_type	"single"
				uiScript  		"saber_type"
				setcvar			ui_saber		"single_1"
				setcvar			ui_saber2		"none"
				uiScript  		"saber_hilt"
				uiScript  		"saber_color"
				uiScript  		"saber2_hilt"
				uiScript  		"saber2_color"
				setitemcolor		typebut_single	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		typebut_dual	forecolor 0.82 0.84 0.88 1 ;
				setitemcolor		typebut_staff	forecolor 0.82 0.84 0.88 1 ;
				show 			sabstyle
				transition2 saber 0 "-110" 640 615 20 10
			}
		}

