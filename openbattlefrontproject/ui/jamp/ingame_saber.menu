//[NewMenus]
{
	menuDef 
	{
		name						"ingame_saber"
		visible						0
		fullscreen					0
//		outOfBoundsClick									// this closes the window if it gets a click out of the rectangle
		rect						120 45 570 400
		focusColor			0.82 0.84 0.88 1
		style						1
		border						1
		descX						320
		descY					421
		descScale					1
		descColor			0.82 0.84 0.88 1
		descAlignment				ITEM_ALIGN_CENTER		

		onOpen  
		{ 
hide				highlights
			hide				rgboptions
			uiScript  			"getsabercvars"
			uiScript  			"saber_hilt"
			uiScript  			"saber_color"
			uiScript  			"saber2_hilt"
			uiScript  			"saber2_color"
			setitemcolor		typebut_single	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		typebut_dual	forecolor 0.82 0.84 0.88 1 ;
			setitemcolor		typebut_staff	forecolor 0.82 0.84 0.88 1 ;
			uiScript			getsaberhiltinfo
		}
		onClose 
		{ 
			hide			highlights
			show 			typebut
			show 			typebut_single
			show 			typebut_dual
			show 			typebut_staff
			show 			hilttype
			show			hiltbut
			show			hiltbut1
			show			hiltbut2
			show			hiltbut_staves
			hide 			rgboptions
			close				ingame_saber2
			uiScript 		"updatesabercvars"
			uiScript  		"saber_color"
			uiScript  		"saber2_color"
		}
		
//------------------------------------------------------------------------------------------------
// Lightsaber
